import { Theme } from "theme.slint";

// ---------------------------------------------------------------------------------------------
// Bloques básicos
// ---------------------------------------------------------------------------------------------
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.surface;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 18px;
        spacing: 4px;
        if root.title != "": Text {
            text: root.title;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
        }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
        VerticalLayout {
            padding-top: 10px;
            spacing: 14px;
            @children
        }
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 2px;
    Text {
        text: root.title;
        font-size: 26px;
        font-weight: 700;
        color: Theme.text;
    }
    if root.subtitle != "": Text {
        text: root.subtitle;
        font-size: 13px;
        color: Theme.muted;
        wrap: word-wrap;
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <string> kind: "secondary"; // primary | secondary | danger | ghost
    in property <bool> enabled: true;
    callback clicked();
    private property <color> fg: kind == "primary" ? Theme.on-accent : kind == "danger" ? Theme.danger : kind == "ghost" ? Theme.muted : Theme.text;
    private property <color> base: kind == "primary" ? Theme.accent : kind == "danger" ? Theme.danger.with-alpha(0.2) : kind == "ghost" ? transparent : Theme.surface2;
    private property <color> hover: kind == "primary" ? Theme.accent-hover : kind == "danger" ? Theme.danger.with-alpha(0.35) : Theme.track;
    height: 38px;
    min-width: Math.max(110px, btn-label.preferred-width + 40px);
    border-radius: Theme.radius-sm;
    border-width: kind == "secondary" ? 1px : 0px;
    border-color: Theme.border;
    background: !enabled ? Theme.surface2 : ta.has-hover ? hover : base;
    btn-label := Text {
        text: root.text;
        color: root.enabled ? root.fg : Theme.muted;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.ok;
    height: 26px;
    border-radius: 13px;
    background: tone.with-alpha(0.18);
    horizontal-stretch: 0;
    min-width: lbl.preferred-width + 24px;
    lbl := Text {
        text: root.text;
        color: root.tone;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Banner informativo: ok | warn | error | info
export component Notice inherits Rectangle {
    in property <string> text;
    in property <string> kind: "info";
    private property <color> tone: kind == "ok" ? Theme.ok : kind == "warn" ? Theme.warn : kind == "error" ? Theme.danger : Theme.accent;
    background: tone.with-alpha(0.14);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: tone.with-alpha(0.45);
    VerticalLayout {
        padding: 12px;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// ---------------------------------------------------------------------------------------------
// Controles
// ---------------------------------------------------------------------------------------------
export component AppSlider inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in-out property <int> value;
    in property <color> accent: Theme.accent;
    in property <bool> enabled: true;
    callback changed(int);
    private property <length> thumb: 18px;
    private property <float> frac: maximum > minimum ? Math.min(1, Math.max(0, (value - minimum) / (maximum - minimum))) : 0;
    height: 22px;

    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: Theme.track;
        Rectangle {
            x: 0;
            width: parent.width * root.frac;
            border-radius: 3px;
            background: root.enabled ? root.accent : Theme.muted.with-alpha(0.5);
        }
    }
    Rectangle {
        x: (root.width - root.thumb) * root.frac;
        y: (root.height - root.thumb) / 2;
        width: root.thumb;
        height: root.thumb;
        border-radius: root.thumb / 2;
        background: !root.enabled ? #6B7589 : ta.has-hover || ta.pressed ? #DDE6F7 : #FFFFFF;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        private property <int> pick: {
            if (root.maximum <= root.minimum) { return root.minimum; }
            let f = Math.min(1, Math.max(0, (self.mouse-x - root.thumb / 2) / (root.width - root.thumb)));
            let raw = root.minimum + f * (root.maximum - root.minimum);
            let snapped = Math.round(raw / root.step) * root.step;
            return Math.min(root.maximum, Math.max(root.minimum, snapped));
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.value = self.pick;
                root.changed(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = self.pick;
                root.changed(root.value);
            }
        }
    }
}

/// Título + valor a la derecha + pista de ayuda + slider con paso fijo.
export component LabeledSlider inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    in property <int> minimum;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    in property <bool> signed;
    in property <color> accent: Theme.accent;
    in-out property <int> value;
    callback changed(int);
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
        }
        Text {
            text: (root.signed && root.value >= 0 ? "+" : "") + root.value + root.unit;
            font-size: 14px;
            font-weight: 700;
            color: root.accent;
            horizontal-alignment: right;
        }
    }
    if root.hint != "": Text {
        text: root.hint;
        font-size: 12px;
        color: Theme.muted;
        wrap: word-wrap;
    }
    AppSlider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        accent: root.accent;
        enabled: root.maximum > root.minimum;
        value <=> root.value;
        changed(v) => { root.changed(v); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: !enabled ? Theme.track : checked ? Theme.accent : Theme.track;
    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.enabled ? #FFFFFF : #6B7589;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component SwitchRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: 12px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        Toggle {
            enabled: root.enabled;
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

export component Checkbox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 24px;
    min-width: 24px + lbl.preferred-width + 8px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 20px;
            height: 20px;
            y: 2px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent : Theme.border;
            background: root.checked ? Theme.accent : transparent;
            Text {
                text: root.checked ? "✓" : "";
                color: Theme.on-accent;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        lbl := Text {
            text: root.text;
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

export component Segmented inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    callback selected(int);
    height: 38px;
    background: Theme.surface2;
    border-radius: Theme.radius-sm;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for label[i] in root.model: Rectangle {
            min-width: 104px;
            border-radius: 8px;
            background: i == root.current-index ? Theme.accent : ta.has-hover ? Theme.track : transparent;
            Text {
                text: label;
                font-size: 13px;
                font-weight: 700;
                color: i == root.current-index ? Theme.on-accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }
        }
    }
}

/// Campo de texto corto (curva de ventiladores, nombres, hex).
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <TextHorizontalAlignment> align: center;
    callback edited(string);
    height: 34px;
    min-width: 64px;
    background: Theme.surface2;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.border;
    ti := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: self.preferred-height;
        y: (parent.height - self.height) / 2;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        horizontal-alignment: root.align;
        single-line: true;
        edited => { root.edited(self.text); }
    }
    if root.text == "" && !ti.has-focus: Text {
        x: 10px;
        text: root.placeholder;
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        width: parent.width - 20px;
        height: parent.height;
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> value;
    in property <color> tone: Theme.accent;
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * Math.min(1, Math.max(0, root.value));
        border-radius: 3px;
        background: root.tone;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

// ---------------------------------------------------------------------------------------------
// Medidor circular animado
// ---------------------------------------------------------------------------------------------
export component Gauge inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> value;
    in property <float> vmax: 100;
    in property <color> base: Theme.accent;
    in property <float> warn-lo: -1;
    in property <float> warn-hi: -1;
    private property <float> size: 168;
    private property <float> sw: 14; // grosor del trazo
    private property <float> cx: size / 2;
    private property <float> r: size / 2 - sw / 2 - 6;
    private property <float> frac: Math.min(1, Math.max(0, value / Math.max(1, vmax)));
    private property <float> shown: frac;
    private property <color> tone: warn-hi >= 0 && value >= warn-hi ? Theme.danger : warn-lo >= 0 && value >= warn-lo ? Theme.warn : base;
    animate shown { duration: 350ms; easing: ease-out; }
    width: 168px;
    height: 168px;

    Path {
        width: 168px;
        height: 168px;
        viewbox-width: 168;
        viewbox-height: 168;
        stroke: Theme.track;
        stroke-width: root.sw * 1px;
        stroke-line-cap: round;
        MoveTo { x: root.cx + root.r * Math.cos(135deg); y: root.cx + root.r * Math.sin(135deg); }
        ArcTo {
            x: root.cx + root.r * Math.cos(45deg);
            y: root.cx + root.r * Math.sin(45deg);
            radius-x: root.r;
            radius-y: root.r;
            large-arc: true;
            sweep: true;
        }
    }
    if root.shown > 0.004: Path {
        width: 168px;
        height: 168px;
        viewbox-width: 168;
        viewbox-height: 168;
        stroke: root.tone;
        stroke-width: root.sw * 1px;
        stroke-line-cap: round;
        MoveTo { x: root.cx + root.r * Math.cos(135deg); y: root.cx + root.r * Math.sin(135deg); }
        ArcTo {
            x: root.cx + root.r * Math.cos((135 + 270 * root.shown) * 1deg);
            y: root.cx + root.r * Math.sin((135 + 270 * root.shown) * 1deg);
            radius-x: root.r;
            radius-y: root.r;
            large-arc: root.shown > 0.6667;
            sweep: true;
        }
    }
    Text {
        y: 168px * 0.45 - self.height / 2;
        width: 100%;
        text: Math.round(root.value);
        font-size: 30px;
        font-weight: 700;
        color: Theme.text;
        horizontal-alignment: center;
    }
    Text {
        y: 168px * 0.64 - self.height / 2;
        width: 100%;
        text: root.unit;
        font-size: 13px;
        color: Theme.muted;
        horizontal-alignment: center;
    }
    Text {
        y: 168px * 0.9 - self.height / 2;
        width: 100%;
        text: root.label;
        font-size: 11px;
        font-weight: 700;
        color: Theme.muted;
        horizontal-alignment: center;
    }
}

// ---------------------------------------------------------------------------------------------
// Iconos vectoriales (rejilla de 24×24)
// ---------------------------------------------------------------------------------------------
export component Icon inherits Rectangle {
    in property <string> kind;
    in property <color> tone: Theme.muted;
    width: 22px;
    height: 22px;

    if root.kind == "monitor": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M3 14 A9 9 0 0 1 21 14 M12 14 L16.5 9 M4 20 L20 20";
        stroke: root.tone; stroke-width: 2.2px; stroke-line-cap: round;
    }
    if root.kind == "monitor": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M10.4 14 A1.6 1.6 0 1 0 13.6 14 A1.6 1.6 0 1 0 10.4 14 Z";
        fill: root.tone;
    }
    if root.kind == "bolt": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M13.5 2 L5 13.5 L11 13.5 L10 22 L19 10 L13 10 Z";
        fill: root.tone;
    }
    if root.kind == "fan": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M12 12 L12.00 2.00 A10 10 0 0 1 19.88 5.84 Z M12 12 L20.66 17.00 A10 10 0 0 1 13.39 21.90 Z M12 12 L3.34 17.00 A10 10 0 0 1 2.73 8.25 Z";
        fill: root.tone;
    }
    if root.kind == "led": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M7.5 12 A4.5 4.5 0 1 0 16.5 12 A4.5 4.5 0 1 0 7.5 12 Z";
        fill: root.tone;
    }
    if root.kind == "led": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M19.60 12.00 L22.60 12.00 M17.37 17.37 L19.50 19.50 M12.00 19.60 L12.00 22.60 M6.63 17.37 L4.50 19.50 M4.40 12.00 L1.40 12.00 M6.63 6.63 L4.50 4.50 M12.00 4.40 L12.00 1.40 M17.37 6.63 L19.50 4.50";
        stroke: root.tone; stroke-width: 1.9px; stroke-line-cap: round;
    }
    if root.kind == "profiles": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M3 6 L21 6 M3 12 L21 12 M3 18 L21 18";
        stroke: root.tone; stroke-width: 1.8px; stroke-line-cap: round;
    }
    if root.kind == "profiles": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M5.4 6 A2.6 2.6 0 1 0 10.6 6 A2.6 2.6 0 1 0 5.4 6 Z M13.4 12 A2.6 2.6 0 1 0 18.6 12 A2.6 2.6 0 1 0 13.4 12 Z M8.4 18 A2.6 2.6 0 1 0 13.6 18 A2.6 2.6 0 1 0 8.4 18 Z";
        fill: root.tone;
    }
    if root.kind == "settings": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M18.50 12.00 L22.60 12.00 M16.60 16.60 L19.50 19.50 M12.00 18.50 L12.00 22.60 M7.40 16.60 L4.50 19.50 M5.50 12.00 L1.40 12.00 M7.40 7.40 L4.50 4.50 M12.00 5.50 L12.00 1.40 M16.60 7.40 L19.50 4.50";
        stroke: root.tone; stroke-width: 3.4px; stroke-line-cap: butt;
    }
    if root.kind == "settings": Path {
        width: 22px; height: 22px; viewbox-width: 24; viewbox-height: 24;
        commands: "M12 6.5 A5.5 5.5 0 1 0 12 17.5 A5.5 5.5 0 1 0 12 6.5 Z";
        stroke: root.tone; stroke-width: 3.2px;
    }
}

export component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    height: 46px;
    border-radius: 12px;
    background: active ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.surface2 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        spacing: 10px;
        Icon {
            kind: root.icon;
            tone: root.active ? Theme.accent : Theme.muted;
            y: (root.height - self.height) / 2;
        }
        Text {
            text: root.label;
            font-size: 14px;
            font-weight: 700;
            color: root.active ? Theme.accent : Theme.muted;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
