// Sistema de diseño de GPU PY (misma paleta que la versión Python).
export global Theme {
    out property <color> bg: #0B0F17;
    out property <color> sidebar: #0F1420;
    out property <color> surface: #141B29;
    out property <color> surface2: #1B2436;
    out property <color> border: #25304A;
    out property <color> track: #222C42;
    out property <color> text: #E8EDF7;
    out property <color> muted: #8793AB;
    out property <color> accent: #4F8CFF;
    out property <color> accent-hover: #6BA0FF;
    out property <color> accent2: #22D3EE;
    out property <color> ok: #34D399;
    out property <color> warn: #FBBF24;
    out property <color> danger: #F43F5E;
    out property <color> violet: #A78BFA;
    out property <color> on-accent: #06101F;

    out property <length> radius: 16px;
    out property <length> radius-sm: 10px;
    out property <length> pad: 20px;
    out property <length> gap: 14px;
    out property <string> font: "Segoe UI";
}
